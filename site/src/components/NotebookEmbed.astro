---
interface Props {
  src: string;
}
const { src } = Astro.props;
---
<div class="notebook-embed">
  <iframe
    src={src}
    width="100%"
    frameborder="0"
    loading="lazy"
    class="notebook-iframe"
  />
</div>

<style>
  .notebook-embed {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .notebook-iframe {
    display: block;
    width: 100%;
    min-height: 400px;
  }
</style>

<script>
  document.querySelectorAll<HTMLIFrameElement>('.notebook-iframe').forEach((iframe) => {
    iframe.addEventListener('load', () => {
      const resize = () => {
        try {
          const h = iframe.contentDocument?.documentElement?.scrollHeight;
          if (h && h > 0) iframe.style.height = h + 'px';
        } catch {}
      };
      resize();
      try {
        new ResizeObserver(resize).observe(iframe.contentDocument!.documentElement);
      } catch {}
    });
  });
</script>
