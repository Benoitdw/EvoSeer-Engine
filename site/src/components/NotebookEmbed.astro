---
interface Props {
  src: string;
  height?: string;
}
const { src, height = '800px' } = Astro.props;
---
<div class="notebook-embed">
  <iframe
    src={src}
    width="100%"
    height={height}
    frameborder="0"
    loading="lazy"
  />
</div>

<style>
  .notebook-embed {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .notebook-embed iframe {
    display: block;
  }
</style>
