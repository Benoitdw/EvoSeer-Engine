---
import MullerPlot from './viz/MullerPlot.astro';
import PhyloTree from './viz/PhyloTree.astro';
import ClonalFractions from './viz/ClonalFractions.astro';
---

<!-- Drop zone -->
<div id="drop-zone" class="drop-zone">
  <div class="drop-inner">
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="17 8 12 3 7 8"/>
      <line x1="12" y1="3" x2="12" y2="15"/>
    </svg>
    <p class="drop-text">Drop a <code>.evoseer.json</code> file here</p>
    <label class="drop-btn">
      Browse
      <input id="file-input" type="file" accept=".json" hidden />
    </label>
  </div>
</div>

<!-- App panel (hidden until file loaded) -->
<div id="app-panel" class="app-panel" style="display:none">
  <!-- Meta bar -->
  <div class="meta-bar">
    <span id="meta-filename" class="meta-filename"></span>
    <div class="meta-stats" id="meta-stats"></div>
    <button id="clear-btn" class="clear-btn">✕ Clear</button>
  </div>

  <!-- Clone table -->
  <div id="clone-table-wrap" class="clone-table-wrap">
    <table class="clone-table">
      <thead>
        <tr>
          <th></th>
          <th>Clone</th>
          <th>Gene</th>
          <th>Acq. step</th>
          <th>Final size</th>
          <th>%</th>
        </tr>
      </thead>
      <tbody id="clone-table-body"></tbody>
    </table>
  </div>

  <!-- Tab nav -->
  <div class="tab-nav">
    <button class="tab active" data-tab="muller">Muller Plot</button>
    <button class="tab" data-tab="phylo">Phylogenetic Tree</button>
    <button class="tab" data-tab="clones">Clonal Fractions</button>
  </div>

  <!-- Panels -->
  <div class="panels">
    <div id="panel-muller" class="panel">
      <MullerPlot />
    </div>
    <div id="panel-phylo" class="panel" style="display:none">
      <PhyloTree />
    </div>
    <div id="panel-clones" class="panel" style="display:none">
      <ClonalFractions />
    </div>
  </div>
</div>

<style>
  /* ── Drop zone ── */
  .drop-zone {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed #30363d;
    border-radius: 0.75rem;
    min-height: calc(100vh - 48px - 2rem);
    margin: 1rem;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .drop-zone.drag-over { border-color: #3fb950; background: #0f2d1a22; }
  .drop-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #8b949e;
    text-align: center;
    padding: 2rem;
  }
  .drop-text { margin: 0; font-size: 1rem; color: #e6edf3; }
  .drop-text code { font-family: ui-monospace, monospace; color: #79c0ff; }
  .drop-btn {
    display: inline-block;
    padding: 0.4rem 1.1rem;
    background: #238636;
    color: #fff;
    border-radius: 0.375rem;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background 0.15s;
  }
  .drop-btn:hover { background: #2ea043; }

  /* ── App panel ── */
  .app-panel { display: flex; flex-direction: column; height: calc(100vh - 48px); }

  /* ── Meta bar ── */
  .meta-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid #21262d;
    background: #0d1117;
    flex-shrink: 0;
  }
  .meta-filename {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #8b949e;
    flex-shrink: 0;
  }
  .meta-stats {
    display: flex;
    gap: 1.25rem;
    font-size: 0.78rem;
    color: #8b949e;
    flex: 1;
  }
  .meta-stats span strong { color: #e6edf3; }
  .clear-btn {
    background: none;
    border: 1px solid #30363d;
    border-radius: 0.375rem;
    padding: 0.2rem 0.6rem;
    font-size: 0.78rem;
    color: #8b949e;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.12s, border-color 0.12s;
  }
  .clear-btn:hover { color: #f78166; border-color: #f78166; }

  /* ── Clone table ── */
  .clone-table-wrap {
    flex-shrink: 0;
    overflow-x: auto;
    border-bottom: 1px solid #21262d;
    max-height: 180px;
    overflow-y: auto;
  }
  .clone-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }
  .clone-table thead th {
    position: sticky;
    top: 0;
    background: #0d1117;
    color: #8b949e;
    font-weight: 500;
    text-align: left;
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid #21262d;
    white-space: nowrap;
  }
  .clone-table tbody tr:hover { background: #161b22; }
  .clone-table td {
    padding: 0.3rem 0.75rem;
    color: #e6edf3;
    border-bottom: 1px solid #161b22;
    white-space: nowrap;
  }
  .clone-table td.muted { color: #8b949e; }
  .clone-swatch {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 2px;
    vertical-align: middle;
  }

  /* ── Tab nav ── */
  .tab-nav {
    display: flex;
    padding: 0 1.25rem;
    border-bottom: 1px solid #21262d;
    flex-shrink: 0;
    background: #0d1117;
  }
  .tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.6rem 1.1rem;
    font-size: 0.875rem;
    color: #8b949e;
    cursor: pointer;
    font-weight: 500;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab:hover { color: #e6edf3; }
  .tab.active { color: #3fb950; border-bottom-color: #3fb950; }

  /* ── Panels ── */
  .panels { flex: 1; overflow-y: auto; padding: 0 1.25rem 1.25rem; }
  .panel { padding-top: 0.25rem; }
</style>

<script is:inline>
(function () {
  const dropZone   = document.getElementById('drop-zone');
  const fileInput  = document.getElementById('file-input');
  const appPanel   = document.getElementById('app-panel');
  const metaFile   = document.getElementById('meta-filename');
  const metaStats  = document.getElementById('meta-stats');
  const clearBtn   = document.getElementById('clear-btn');
  const tabs       = document.querySelectorAll('.tab');
  const panels     = { muller: 'panel-muller', phylo: 'panel-phylo', clones: 'panel-clones' };
  const renderers  = { muller: '__evoseerRenderMuller', phylo: '__evoseerRenderPhylo', clones: '__evoseerRenderClones' };

  let activeTab = 'muller';

  function loadFile(file) {
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(reader.result);
        window.__evoseerLoadFile(file.name, data);
      } catch {
        alert('Failed to parse file — expected a valid .evoseer.json');
      }
    };
    reader.readAsText(file);
  }

  window.__evoseerLoadFile = function (filename, data) {
    window.__evoseerData = data;
    showApp(filename, data);
    switchTab('muller');
  };

  const CLONE_PALETTE = [
    '#58a6ff','#3fb950','#ffa657','#f78166','#d2a8ff',
    '#79c0ff','#56d364','#ff9f43','#ff6b6b','#a29bfe',
    '#00cec9','#fdcb6e','#e17055','#74b9ff','#55efc4',
    '#fd79a8','#b2bec3','#6c5ce7','#fab1a0','#81ecec',
  ];
  const WT_COLOR = '#6e7681';

  function swatchColor(node, idx) {
    if (node.id === 'wt') return WT_COLOR;
    return CLONE_PALETTE[idx % CLONE_PALETTE.length];
  }

  function showApp(filename, data) {
    dropZone.style.display = 'none';
    appPanel.style.display = 'flex';
    metaFile.textContent = filename;

    const last = data.snapshots?.[data.snapshots.length - 1];
    const activeNodes = data.clone_tree?.nodes?.filter(n => n.final_size > 0) ?? [];
    const stop = data.metadata?.stop_reason ?? '—';
    metaStats.innerHTML =
      `<span><strong>${last?.n_alive?.toLocaleString() ?? '—'}</strong> cells</span>` +
      `<span><strong>${activeNodes.length}</strong> active clones</span>` +
      `<span>stop: <strong>${stop}</strong></span>`;

    populateCloneTable(data, activeNodes);
  }

  function populateCloneTable(data, activeNodes) {
    const tbody = document.getElementById('clone-table-body');
    if (!tbody) return;

    const totalCells = activeNodes.reduce((s, n) => s + n.final_size, 0);
    const sorted = [...activeNodes].sort((a, b) => b.final_size - a.final_size);

    // Colour index: wt is excluded from palette indexing (same logic as buildCloneColorMap)
    const allNodes = [...(data.clone_tree?.nodes ?? [])].sort((a, b) =>
      a.id === 'wt' ? -1 : b.id === 'wt' ? 1 : a.acq_step - b.acq_step
    );
    let _ci = 0;
    const colorIdx = new Map(allNodes.map(n => [n.id, n.id === 'wt' ? -1 : _ci++]));

    tbody.innerHTML = sorted.map(node => {
      const pct = totalCells > 0 ? (node.final_size / totalCells * 100).toFixed(1) : '0.0';
      const color = swatchColor(node, colorIdx.get(node.id) ?? 0);
      return `<tr>
        <td><span class="clone-swatch" style="background:${color}"></span></td>
        <td>${node.label || node.id}</td>
        <td class="muted">${node.gene ?? '—'}</td>
        <td class="muted">${node.acq_step.toLocaleString()}</td>
        <td>${node.final_size.toLocaleString()}</td>
        <td>${pct}%</td>
      </tr>`;
    }).join('');
  }

  function switchTab(name) {
    activeTab = name;
    tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === name));
    Object.entries(panels).forEach(([k, id]) => {
      document.getElementById(id).style.display = k === name ? '' : 'none';
    });
    if (window.__evoseerData && window[renderers[name]]) {
      window[renderers[name]](window.__evoseerData);
    }
  }

  function reset() {
    window.__evoseerData = null;
    appPanel.style.display = 'none';
    dropZone.style.display = '';
    fileInput.value = '';
  }

  // Tab clicks
  tabs.forEach(t => t.addEventListener('click', () => switchTab(t.dataset.tab)));

  // Clear
  clearBtn.addEventListener('click', reset);

  // Drop zone
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file) loadFile(file);
  });
  dropZone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) loadFile(fileInput.files[0]);
  });
})();
</script>
