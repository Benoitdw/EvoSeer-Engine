---
---

<div class="muller-controls">
  <div class="toggle-group" id="muller-xmode">
    <button class="tgl active" data-val="time">Time</button>
    <button class="tgl" data-val="step">Cycle</button>
  </div>
  <div class="toggle-group" id="muller-ymode">
    <button class="tgl active" data-val="fraction">Fraction</button>
    <button class="tgl" data-val="n">N cells</button>
  </div>
</div>
<div class="muller-wrap">
  <canvas id="muller-canvas"></canvas>
</div>

<style>
  .muller-controls {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem 0 0.75rem;
  }
  .toggle-group {
    display: flex;
    border: 1px solid #30363d;
    border-radius: 0.375rem;
    overflow: hidden;
  }
  .tgl {
    background: none;
    border: none;
    padding: 0.2rem 0.65rem;
    cursor: pointer;
    font-size: 0.8rem;
    color: #8b949e;
    transition: background 0.12s, color 0.12s;
  }
  .tgl + .tgl { border-left: 1px solid #30363d; }
  .tgl.active { background: #21262d; color: #e6edf3; }
  .muller-wrap { position: relative; height: 380px; }
  #muller-canvas { display: block; width: 100% !important; height: 100% !important; cursor: crosshair; }
</style>

<script>
import Chart from 'chart.js/auto';
import { buildCloneColorMap } from '../../utils/clone-colors';

// ── Crosshair plugin ────────────────────────────────────────────────────────
const crosshairPlugin = {
  id: 'mullerCrosshair',
  afterDraw(chart: any) {
    const hover = chart._hoverState;
    if (!hover) return;
    const { ctx, chartArea, scales } = chart;
    const { xPx, dataIdx } = hover;

    ctx.save();

    ctx.beginPath();
    ctx.moveTo(xPx, chartArea.top);
    ctx.lineTo(xPx, chartArea.bottom);
    ctx.strokeStyle = '#f85149';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    let cumVal = 0;
    chart.data.datasets.forEach((ds: any) => {
      const pt = ds.data[dataIdx];
      if (!pt) return;
      const val = pt.y ?? 0;
      if (val <= 0) return;

      const yBottom = scales.y.getPixelForValue(cumVal);
      const yTop    = scales.y.getPixelForValue(cumVal + val);
      const yMid    = (yBottom + yTop) / 2;
      const areaH   = Math.abs(yBottom - yTop);
      cumVal += val;

      if (areaH < 14) return;

      const label = chart._yMode === 'fraction'
        ? val.toFixed(3)
        : Math.round(val).toLocaleString();

      const labelX = xPx + 8 > chartArea.right - 55 ? xPx - 55 : xPx + 8;

      ctx.font = 'bold 12px ui-monospace, monospace';
      ctx.textAlign = 'left';
      const tw = ctx.measureText(label).width;
      const pad = 3;
      ctx.fillStyle = 'rgba(0,0,0,0.72)';
      ctx.fillRect(labelX - pad, yMid - 10, tw + pad * 2, 16);
      ctx.fillStyle = '#ffffff';
      ctx.fillText(label, labelX, yMid + 4);
    });

    ctx.restore();
  },
};

Chart.register(crosshairPlugin);

// ── State ───────────────────────────────────────────────────────────────────
let chart: any = null;
let xMode = 'time';
let yMode = 'fraction';

// ── Render ──────────────────────────────────────────────────────────────────
function render(data: any) {
  const canvas = document.getElementById('muller-canvas') as HTMLCanvasElement | null;
  if (!canvas || !data) return;
  const fracs = data.clonal_fractions;
  if (!fracs || !fracs.length) return;

  const nodes = [...data.clone_tree.nodes].sort((a: any, b: any) =>
    a.id === 'wt' ? -1 : b.id === 'wt' ? 1 : a.acq_step - b.acq_step
  );
  const colorMap = buildCloneColorMap(nodes);
  const total = (row: any) => nodes.reduce((s: number, n: any) => s + (row[n.id] ?? 0), 0);

  const datasets = nodes.map((node: any) => {
    const color = colorMap.get(node.id) ?? '#6e7681';
    const pts = fracs.map((row: any) => {
      const v = row[node.id] ?? 0;
      const x = xMode === 'time' ? row.t : row.step;
      const y = yMode === 'fraction' ? (total(row) > 0 ? v / total(row) : 0) : v;
      return { x, y };
    });
    return {
      label: node.label || node.id,
      data: pts,
      backgroundColor: color + 'cc',
      borderColor: color,
      borderWidth: 0.5,
      fill: true,
      stack: 'pop',
      pointRadius: 0,
      tension: 0.2,
    };
  });

  if (chart) { chart.destroy(); chart = null; }
  chart = new Chart(canvas, {
    type: 'line',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      scales: {
        x: {
          type: 'linear',
          ticks: { color: '#8b949e', maxTicksLimit: 8 },
          grid: { color: '#21262d' },
          title: { display: true, text: xMode === 'time' ? 'Time' : 'Cycle', color: '#8b949e' },
        },
        y: {
          stacked: true,
          ticks: { color: '#8b949e' },
          grid: { color: '#21262d' },
          title: { display: true, text: yMode === 'fraction' ? 'Fraction' : 'N cells', color: '#8b949e' },
          max: yMode === 'fraction' ? 1 : undefined,
        },
      },
      plugins: {
        legend: { display: false },
        tooltip: { enabled: false },
      },
    },
  });

  chart._yMode = yMode;

  canvas.addEventListener('mousemove', (e) => {
    if (!chart) return;
    const rect = canvas.getBoundingClientRect();
    const xPx = e.clientX - rect.left;
    const { chartArea, scales, data: cData } = chart;
    if (!chartArea || xPx < chartArea.left || xPx > chartArea.right) {
      chart._hoverState = null;
      chart.draw();
      return;
    }
    const xVal = scales.x.getValueForPixel(xPx);
    const pts = cData.datasets[0]?.data ?? [];
    let nearestIdx = 0, minDist = Infinity;
    pts.forEach((pt: any, i: number) => {
      const d = Math.abs(pt.x - xVal);
      if (d < minDist) { minDist = d; nearestIdx = i; }
    });
    const snapX = scales.x.getPixelForValue(pts[nearestIdx]?.x ?? xVal);
    chart._hoverState = { xPx: snapX, dataIdx: nearestIdx };
    chart.draw();
  });

  canvas.addEventListener('mouseleave', () => {
    if (!chart) return;
    chart._hoverState = null;
    chart.draw();
  });
}

(window as any).__evoseerRenderMuller = render;

// ── Toggle controls ────────────────────────────────────────────────────────
document.querySelectorAll('#muller-xmode .tgl').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#muller-xmode .tgl').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    xMode = (btn as HTMLElement).dataset.val!;
    render((window as any).__evoseerData);
  });
});
document.querySelectorAll('#muller-ymode .tgl').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#muller-ymode .tgl').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    yMode = (btn as HTMLElement).dataset.val!;
    render((window as any).__evoseerData);
  });
});
</script>
