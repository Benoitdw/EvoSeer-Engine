---
import AppLayout from '../layouts/AppLayout.astro';
import Visualizer from '../components/Visualizer.astro';
---

<AppLayout title="EvoSeer — Visualizer">
  <Fragment slot="head">
  </Fragment>

  <Fragment slot="topbar">
    <div style="display:flex;gap:0.4rem;align-items:center;">
    <button id="topbar-load-btn" class="topbar-load">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      Load file
    </button>
    <button id="topbar-reload-btn" class="topbar-reload" title="Reload file" disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="23 4 23 10 17 10"/>
        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
      </svg>
    </button>
    </div>
  </Fragment>

  <Visualizer />
</AppLayout>

<style>
  .topbar-load {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid #30363d;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    color: #8b949e;
    background: none;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .topbar-load:hover { color: #e6edf3; border-color: #8b949e; }

  .topbar-reload {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.5rem;
    border: 1px solid #30363d;
    border-radius: 0.375rem;
    background: none;
    color: #8b949e;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .topbar-reload:hover:not(:disabled) { color: #e6edf3; border-color: #8b949e; }
  .topbar-reload:disabled { opacity: 0.35; cursor: default; }
</style>

<script is:inline>
  let _lastFile = null;
  const _picker = document.createElement('input');
  _picker.type = 'file';
  _picker.accept = '.json';

  async function loadFromFile(file) {
    const text = await file.text();
    try {
      const data = JSON.parse(text);
      window.__evoseerLoadFile(file.name, data);
      _lastFile = file;
      document.getElementById('topbar-reload-btn').disabled = false;
    } catch {
      alert('Failed to parse file — expected a valid .evoseer.json');
    }
  }

  _picker.addEventListener('change', () => {
    if (_picker.files?.[0]) loadFromFile(_picker.files[0]);
    _picker.value = '';
  });

  document.getElementById('topbar-load-btn').addEventListener('click', () => _picker.click());
  document.getElementById('topbar-reload-btn').addEventListener('click', () => {
    if (_lastFile) loadFromFile(_lastFile);
  });
</script>
