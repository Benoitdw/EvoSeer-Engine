---
---

<div class="phylo-header">
  <button id="phylo-toggle" class="phylo-toggle-btn">Top 20 only</button>
</div>
<div id="phylo-container" class="phylo-container"></div>

<style>
  .phylo-header {
    display: flex;
    justify-content: flex-end;
    padding: 0.5rem 0 0.5rem;
  }
  .phylo-toggle-btn {
    background: none;
    border: 1px solid #30363d;
    border-radius: 0.375rem;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    color: #8b949e;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }
  .phylo-toggle-btn:hover { color: #e6edf3; border-color: #8b949e; }
  .phylo-container {
    width: 100%;
    overflow-x: auto;
    overflow-y: auto;
    max-height: 440px;
  }
  .phylo-container svg { display: block; }
</style>

<script>
import * as d3 from 'd3';
import { buildCloneColorMap } from '../../utils/clone-colors';

let showTop20 = true;

function buildHierarchy(nodes: any[], edges: any[]) {
  const map = new Map(nodes.map(n => [n.id, { ...n, children: [] as any[] }]));
  for (const e of edges) {
    const p = map.get(e.parent);
    const c = map.get(e.child);
    if (p && c) p.children.push(c);
  }
  const hasParent = new Set(edges.map((e: any) => e.child));
  const root = nodes.find(n => !hasParent.has(n.id));
  return root ? map.get(root.id) : map.get(nodes[0].id);
}

function filterTop20(allNodes: any[], edges: any[]) {
  const parentOf: Record<string, string> = {};
  for (const e of edges) parentOf[e.child] = e.parent;
  const top20ids = new Set(
    [...allNodes].sort((a, b) => b.final_size - a.final_size)
      .slice(0, 20).map((n: any) => n.id)
  );
  for (const id of [...top20ids]) {
    let cur = parentOf[id];
    while (cur) { top20ids.add(cur); cur = parentOf[cur]; }
  }
  return allNodes.filter(n => top20ids.has(n.id));
}

function render(data: any) {
  const container = document.getElementById('phylo-container');
  if (!container || !data) return;

  const allActive = data.clone_tree.nodes.filter((n: any) => n.final_size > 0);
  const edges = data.clone_tree.edges;
  const nodes = showTop20 ? filterTop20(allActive, edges) : allActive;

  const activeEdges = edges.filter((e: any) =>
    nodes.some((n: any) => n.id === e.parent) && nodes.some((n: any) => n.id === e.child)
  );

  const hierarchy = buildHierarchy(nodes, activeEdges);
  if (!hierarchy) { container.innerHTML = '<p style="color:#8b949e;padding:1rem">No data</p>'; return; }

  const W = container.clientWidth || 900;
  const rowH = Math.max(22, Math.min(36, 600 / nodes.length));
  const H = Math.max(300, nodes.length * rowH + 60);
  const PAD = { top: 20, right: 140, bottom: 20, left: 20 };

  const root = d3.hierarchy(hierarchy);
  const treeLayout = d3.tree<any>().size([H - PAD.top - PAD.bottom, W - PAD.left - PAD.right]);
  treeLayout(root);

  const maxSize = d3.max(root.descendants(), d => d.data.final_size) || 1;
  const rScale = d3.scaleSqrt().domain([0, maxSize]).range([3, 16]);

  const colorMap = buildCloneColorMap(data.clone_tree.nodes);

  container.innerHTML = '';
  const svg = d3.select('#phylo-container')
    .append('svg')
    .attr('width', W)
    .attr('height', H);

  const g = svg.append('g')
    .attr('transform', `translate(${PAD.left + 20},${PAD.top})`);

  g.selectAll('.link')
    .data(root.links())
    .join('path')
    .attr('class', 'link')
    .attr('d', d3.linkHorizontal<any, any>().x(d => d.y).y(d => d.x))
    .attr('fill', 'none')
    .attr('stroke', '#30363d')
    .attr('stroke-width', 1.5);

  d3.selectAll('.evoseer-phylo-tip').remove();
  const tip = d3.select('body').append('div')
    .attr('class', 'evoseer-phylo-tip')
    .style('position', 'absolute')
    .style('visibility', 'hidden')
    .style('background', '#161b22')
    .style('border', '1px solid #30363d')
    .style('border-radius', '6px')
    .style('padding', '8px 12px')
    .style('font-size', '12px')
    .style('color', '#e6edf3')
    .style('pointer-events', 'none')
    .style('z-index', '1000')
    .style('line-height', '1.6');

  const node = g.selectAll('.node')
    .data(root.descendants())
    .join('g')
    .attr('class', 'node')
    .attr('transform', d => `translate(${d.y},${d.x})`);

  node.append('circle')
    .attr('r', d => rScale(d.data.final_size))
    .attr('fill', d => colorMap.get(d.data.id) ?? '#6e7681')
    .attr('opacity', 0.9)
    .style('cursor', 'pointer')
    .on('mouseover', function (event, d) {
      d3.select(this).attr('stroke', '#e6edf3').attr('stroke-width', 2);
      tip.html(
        `<strong>${d.data.label || d.data.id}</strong><br/>` +
        `Size: ${d.data.final_size.toLocaleString()} cells<br/>` +
        (d.data.gene ? `Gene: ${d.data.gene}<br/>` : '') +
        `Acq. step: ${d.data.acq_step}`
      ).style('visibility', 'visible');
    })
    .on('mousemove', (event) => {
      tip.style('top', (event.pageY - 10) + 'px').style('left', (event.pageX + 14) + 'px');
    })
    .on('mouseout', function () {
      d3.select(this).attr('stroke', null);
      tip.style('visibility', 'hidden');
    });

  node.append('text')
    .attr('dx', d => rScale(d.data.final_size) + 5)
    .attr('dy', 4)
    .attr('font-size', 11)
    .attr('fill', '#8b949e')
    .text(d => d.data.label || d.data.id);
}

(window as any).__evoseerRenderPhylo = render;

const btn = document.getElementById('phylo-toggle');
if (btn) {
  btn.addEventListener('click', () => {
    showTop20 = !showTop20;
    btn.textContent = showTop20 ? 'Top 20 only' : 'All clones';
    render((window as any).__evoseerData);
  });
}
</script>
